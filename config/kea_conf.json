{
"Dhcp4": {
  "interfaces-config": {
    "interfaces": [ "cyberlab" ]
  },

  "valid-lifetime": 86400,
  "renew-timer": 43200,
  "rebind-timer": 75 600,

  "authoritative": true,

  "lease-database": {
    "type": "memfile",
    "persist": "true",
    "name": "/var/lib/kea/kea/leases4.csv",
    "lfc-interval": 3600,  
  }, 

  "subnet4": [
    {
      "subnet": "192.168.123.0/24",
      "pools": [ { "pool": "192.168.123.100 - 192.168.123.200" } ],
      "option-data": [
        {
          "name": "domain-name-servers",
          "data": "127.0.0.1" 
        },
        {
          "name": "domain-search",
          "data": "127.0.0.1"
        },
        {
          "name": "routers",
          "data": "127.0.0.1
        }
      ]
    }
  ]
}
}
